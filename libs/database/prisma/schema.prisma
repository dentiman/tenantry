generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// MT-1: tenant (перейменовано з Organization 2026-07-16 — «організація» лишається вільним
// доменним словом для споживачів скелетона). Single-tenant = рівно один рядок (N=1).
// Політика RLS (MT-2): tenant бачить ЛИШЕ власний рядок (id = current_setting).
model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique // під логін по slug (MT-3) і піддомени (MT-4)
  name      String
  // suspend/resume тенанта: login відмовляє всім юзерам неактивного tenant-а
  isActive  Boolean  @default(true) @map("is_active")
  // Дефолтна локаль для нових юзерів тенанта
  locale    String   @default("en")
  // Валюта розрахунків воркспейсу (ISO 4217) — дефолт для нових кастомерів і
  // для будь-якого показу сум. КОЛОНКА, а не settings Json: закритий формат,
  // і платформа колись питатиме «усі тенанти з currency=EUR» (docs/workspace-settings.md)
  currency  String   @default("USD") @db.Char(3)
  // Гнучкі налаштування (feature-flags, UI-преференси); типізовані — окремими колонками
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                    User[]
  authSessions             AuthSession[]
  verificationTokens       VerificationToken[]
  files                    File[]
  attachments              Attachment[]
  activities               Activity[]
  activityLinks            ActivityLink[]
  notifications            Notification[]
  notificationStates       NotificationState[]
  notificationPreferences  NotificationPreference[]
  customers                Customer[]
  customerContacts         CustomerContact[]
  numberSequences          NumberSequence[]
  numberSeries             NumberSeries[]
  calendarEvents           CalendarEvent[]
  calendarEventAttendees   CalendarEventAttendee[]
  calendarReminders        CalendarReminder[]
  scheduledNotifications   ScheduledNotification[]
  aiConversations          AiConversation[]
  aiMessages               AiMessage[]
  aiUsageCounters          AiUsageCounter[]
  aiKnowledgeSources       AiKnowledgeSource[]
  aiKnowledgeDocuments     AiKnowledgeDocument[]
  aiKnowledgeChunks        AiKnowledgeChunk[]
  conversations            Conversation[]
  conversationParticipants ConversationParticipant[]
  chatMessages             ChatMessage[]

  @@map("tenants")
}

// Base user model for the CRM template
model User {
  id           String    @id @default(uuid())
  // MT-1: заповнюється DB-default-ом current_setting('app.tenant_id') — доменний код його НЕ передає
  tenantId     String    @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  email        String
  name         String?
  passwordHash String?   @map("password_hash")
  role         Role      @default(USER)
  isActive     Boolean   @default(true) @map("is_active")
  // I18N-3: локаль для server-rendered тексту (email); UI-перемикач мови — I18N-4
  locale       String    @default("en")
  // Календар: IANA-зона юзера (docs/calendar.md §6.1). NULL = «як в організації»
  // (settings.calendar.timeZone). Окремо від locale свідомо: локаль задає ФОРМАТ,
  // зона — який саме це момент; людина в Берліні з англійським UI — норма
  timeZone     String?   @map("time_zone")
  // Телефон завжди в E.164 (валідує PhoneNumberSchema в contracts). phoneCountry потрібен
  // окремо, бо за кодом країни номер не відновлюється однозначно: +1 — це US, CA і десяток
  // карибських країн, і без збереженого вибору UI показав би не той прапор при редагуванні
  phone        String?
  phoneCountry String?   @map("phone_country") @db.Char(2)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  // Демо-споживач файлової підсистеми (Files v1)
  avatarFileId String?   @map("avatar_file_id")
  // RT-3: найпізніший момент, коли система ТОЧНО знала про живе socket-зʼєднання юзера
  // (high-water mark, а НЕ «момент дисконекту»: у режимах відмов дисконект не настає
  // взагалі). NULL — жодного разу не підключався. Пишеться ТІЛЬКИ presence-шаром
  // (LastSeenWriter) сирим UPDATE-ом — Prisma-update підняв би @updatedAt і сесія
  // виглядала б як редагування профілю. З доменного коду не чіпати.
  lastSeenAt   DateTime? @map("last_seen_at")

  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authSessions            AuthSession[]
  verificationTokens      VerificationToken[]
  // Персональний інбокс (docs/notifications.md): іде разом із юзером — це його
  // особисті дані, а не журнал (журнал — activities, він переживає видалення)
  notifications           Notification[]            @relation("NotificationRecipient")
  notificationState       NotificationState?        @relation("NotificationState")
  notificationPreferences NotificationPreference[]  @relation("NotificationPreference")
  // FK НЕ композитний свідомо: onDelete SetNull з композитним FK занулив би і tenant_id
  // (Prisma не вміє SET NULL з переліком колонок). Крос-tenant захист — RLS на обох таблицях.
  avatarFile              File?                     @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  uploadedFiles           File[]                    @relation("UploadedFiles")
  ownedCustomers          Customer[]                @relation("CustomerOwner")
  organizedEvents         CalendarEvent[]           @relation("CalendarEventOwner")
  eventAttendances        CalendarEventAttendee[]
  calendarReminders       CalendarReminder[]
  scheduledNotifications  ScheduledNotification[]   @relation("ScheduledNotificationRecipient")
  aiConversations         AiConversation[]          @relation("AiConversationOwner")
  aiUsageCounters         AiUsageCounter[]          @relation("AiUsageCounterOwner")
  conversationMemberships ConversationParticipant[]
  chatMessages            ChatMessage[]             @relation("ChatMessageSender")

  // Email унікальний У МЕЖАХ tenant-а (та сама людина у двох тенантах = два акаунти)
  @@unique([tenantId, email])
  // Опора для композитних FK з інших таблиць
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("users")
}

enum Role {
  ADMIN
  USER
}

/// AUTH-1: сесія = ПРИСТРІЙ, а не рядок refresh-токена. Раніше ротація робила
/// delete+create з новим id, тож «сесія» як сутність, яку можна показати в списку
/// і вибірково вбити, у моделі просто не існувала. Тепер id стабільний (він же
/// `sid` у access-токені й середній сегмент refresh-токена), а ротація міняє лише
/// секрет — список пристроїв і точковий revoke стають можливими.
model AuthSession {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  userId   String @map("user_id")

  /// `sha256:<hex>` — секрет має 256 біт ентропії, розтягувати його argon2 нічого не
  /// дає (перебір неможливий за побудовою), а ротація на кожен refresh робила б
  /// ~100 мс CPU на запит. `argon2:<phc>` — рядки, перенесені міграцією зі старої
  /// таблиці; перша ж успішна ротація переписує їх на `sha256:`.
  tokenHash String @map("token_hash")

  /// Попереднє покоління секрету. Живе вікном (константа в AuthSessionService) від
  /// `prevRotatedAt`: два паралельні запити з однієї вкладки (або обірваний на
  /// пів-дорозі refresh) не мусять виглядати як крадіжка токена.
  prevTokenHash String?   @map("prev_token_hash")
  prevRotatedAt DateTime? @map("prev_rotated_at")
  generation    Int       @default(0)

  issuedAt          DateTime @default(now()) @map("issued_at")
  lastUsedAt        DateTime @default(now()) @map("last_used_at")
  /// Посувається кожною ротацією — «сесія жива, поки нею користуються»
  idleExpiresAt     DateTime @map("idle_expires_at")
  /// Рахується від `issuedAt` і НЕ посувається: стеля життя пристрою
  absoluteExpiresAt DateTime @map("absolute_expires_at")

  /// Рядок лишається після відкликання (на відміну від старого `delete`): без нього
  /// неможливо відрізнити «сесії ніколи не було» від «її щойно вбили» — а саме на
  /// цій різниці стоїть reuse-detection
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  userAgent   String? @map("user_agent")
  ip          String?
  /// parseUserAgent(userAgent) — ключ, за яким вхід визначається як «новий пристрій»
  deviceLabel String? @map("device_label")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK: сесія не може вказати на юзера чужого tenant-а (FK-перевірки обходять RLS)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, idleExpiresAt])
  @@map("auth_sessions")
}

/// AUTH-3: одноразові посилання (скидання пароля, зміна email). Одна таблиця на всі
/// призначення (`purpose`) замість окремої на кожне — стани й механіка споживання
/// (атомарний умовний UPDATE) однакові, різниться лише payload.
model VerificationToken {
  id       String              @id @default(uuid())
  tenantId String              @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  userId   String              @map("user_id")
  purpose  VerificationPurpose

  /// `sha256:<hex>` — секрет 256 біт ентропії, той самий протокол, що в auth_sessions
  tokenHash String @map("token_hash")

  /// `EMAIL_CHANGE` → `{ newEmail }`; інші purpose payload не потребують
  payload Json @default("{}")

  /// `now + 60 хв` (константа VerificationTokenService)
  expiresAt DateTime  @map("expires_at")
  /// ≠ null → використано; атомарний умовний UPDATE ставить це поле
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdIp String?   @map("created_ip")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId, purpose])
  @@map("verification_tokens")
}

enum VerificationPurpose {
  PASSWORD_RESET
  EMAIL_CHANGE
  /// Флоу немає в цій фазі — резерв на інвайти майбутнього MT-4
  INVITE
}

// Файлова підсистема (Files v1): метадані об'єктів S3-сховища.
// Байти живуть у S3 (dev: SeaweedFS), тут — тільки метадані і статус двофазного upload-у:
// PENDING (виданий presigned PUT, байтів може ще не бути) → READY (complete підтвердив HeadObject).
// PENDING старші за поріг прибирає cron files.cleanup-orphans (S3-об'єкт + рядок).
model File {
  id           String     @id @default(uuid())
  tenantId     String     @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  // Ключ у бакеті: {tenantId}/{yyyy}/{mm}/{uuid}[.ext] — НЕ оригінальна назва (MT-1: tenant-префікс)
  key          String     @unique
  filename     String
  mimeType     String     @map("mime_type")
  size         Int
  status       FileStatus @default(PENDING)
  // Мініатюра зображення (worker, sharp); для не-зображень завжди null
  thumbnailKey String?    @map("thumbnail_key")
  uploadedById String?    @map("uploaded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // FK не композитний: onDelete SetNull (див. коментар у User.avatarFile)
  uploadedBy  User?        @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: SetNull)
  attachments Attachment[]
  avatarOf    User[]       @relation("UserAvatar")

  // Опора для композитних FK (attachments)
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  // Глобальний індекс для системного cron-у cleanup-orphans (BYPASSRLS, шукає PENDING по всіх тенантах)
  @@index([status, createdAt])
  @@map("files")
}

enum FileStatus {
  PENDING
  READY
}

// Універсальна прив'язка файлу до доменної сутності (customers/tickets у майбутніх фазах).
// Полиморфний (entityType — рядок), тому без FK на сутність; цілісність — відповідальність домену.
model Attachment {
  id         String   @id @default(uuid())
  tenantId   String   @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  fileId     String   @map("file_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK: attachment не може вказати на файл чужого tenant-а
  file   File   @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, fileId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
  @@map("attachments")
}

// MT-3: identity CONTROL PLANE (apps/platform-api) — оператори платформи.
// СВІДОМО окрема від users: інший login-флоу, інший JWT-secret, без tenant_id.
// Доступ ТІЛЬКИ ролі saas_platform (міграція робить REVOKE від saas_app —
// tenant-api цю таблицю навіть прочитати не може).
model PlatformUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  authSessions PlatformAuthSession[]

  @@map("platform_users")
}

/// AUTH-2: дзеркало `AuthSession` у control plane (план §3.4) — «чесна копія», а не
/// спільне ядро: різні Prisma-моделі й формат токена (без tenant-префікса), третього
/// споживача механіки немає (конституція VIII). БЕЗ `tenant_id` і БЕЗ RLS —
/// `platform_users` живуть поза tenant-ізоляцією, як і сама таблиця; міграція робить
/// `REVOKE ALL … FROM saas_app`, як для `platform_users`.
model PlatformAuthSession {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// `sha256:<hex>` — той самий протокол ротації, що в tenant-плані; тут перенесення
  /// зі старих `argon2:`-рядків не потрібне (control plane refresh-механіки не мав)
  tokenHash String @map("token_hash")

  prevTokenHash String?   @map("prev_token_hash")
  prevRotatedAt DateTime? @map("prev_rotated_at")
  generation    Int       @default(0)

  issuedAt          DateTime @default(now()) @map("issued_at")
  lastUsedAt        DateTime @default(now()) @map("last_used_at")
  idleExpiresAt     DateTime @map("idle_expires_at")
  absoluteExpiresAt DateTime @map("absolute_expires_at")

  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  userAgent   String? @map("user_agent")
  ip          String?
  deviceLabel String? @map("device_label")

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idleExpiresAt])
  @@map("platform_auth_sessions")
}

// Журнал бізнес-подій (docs/activity-log.md). Append-only: без updatedAt,
// без UPDATE/DELETE через API. Текст НЕ зберігається — type + payload,
// рендерить фронт (i18n-доктрина: бекенд — коди).
model Activity {
  id         String   @id @default(uuid())
  tenantId   String   @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  // Закритий enum у контрактах (ACTIVITY_TYPES); у БД — рядок (нові типи без міграції)
  type       String
  actorType  String   @map("actor_type") // 'user' | 'system'
  // БЕЗ FK на users свідомо: снапшот — юзера можуть видалити, фід мусить жити
  actorId    String?  @map("actor_id")
  actorLabel String?  @map("actor_label") // снапшот (email/ім'я) на момент події
  // Параметри для рендеру: снапшот-label-и + {kind, id}-референси (схема — по типу)
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  links  ActivityLink[]

  // Опора для композитного FK з activity_links
  @@unique([tenantId, id])
  // Tenant-wide фід + tie-breaker курсора
  @@index([tenantId, createdAt(sort: Desc), id])
  @@map("activities")
}

// Прив'язка події до сутностей, яких вона стосується (1 подія → N сутностей).
// Поліморфний (entityType — рядок), без FK на сутність — як attachments.
model ActivityLink {
  activityId String  @map("activity_id")
  tenantId   String  @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  entityType String  @map("entity_type") // 'user' | 'customer' | 'ticket' …
  entityId   String  @map("entity_id")
  // Семантика зв'язку: 'subject' | 'target' | 'source' | 'context'; NULL коли
  // неоднозначності немає. Словник валідує Zod-схема типу події, не БД
  role       String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK: лінк не може вказати на активність чужого tenant-а
  activity Activity @relation(fields: [tenantId, activityId], references: [tenantId, id], onDelete: Cascade)

  @@id([activityId, entityType, entityId])
  // Головний запит: фід сутності
  @@index([tenantId, entityType, entityId])
  @@map("activity_links")
}

// Персональний інбокс користувача (docs/notifications.md). На відміну від Activity —
// рядок МУТАБЕЛЬНИЙ: read_at/archived_at/колапс. Текст не зберігається: type + payload,
// рендерить фронт через i18next (та сама i18n-доктрина, що в activities).
model Notification {
  id          String    @id @default(uuid())
  tenantId    String    @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  // Кому. NOT NULL завжди: broadcast без отримувача — поза скопом V1
  recipientId String    @map("recipient_id")
  // Закритий enum у контрактах (NOTIFICATION_TYPES); у БД — рядок (нові типи без міграції)
  type        String
  payload     Json
  // Одна канонічна ціль кліку (на відміну від activity_links, яких буває N).
  // Nullable: буває сповіщення без переходу (welcome)
  targetKind  String?   @map("target_kind")
  targetId    String?   @map("target_id")
  // Ключ колапсу: N однотипних подій зливаються в один НЕПРОЧИТАНИЙ рядок
  groupKey    String?   @map("group_key")
  groupCount  Int       @default(1) @map("group_count")
  // Актор — та сама форма, що в activities (снапшот, без FK на users)
  actorType   String    @map("actor_type")
  actorId     String?   @map("actor_id")
  actorLabel  String?   @map("actor_label")
  createdAt   DateTime  @default(now()) @map("created_at")
  // Час ОСТАННЬОЇ появи: по ньому сортується фід, його ж рухає колапс
  updatedAt   DateTime  @updatedAt @map("updated_at")
  readAt      DateTime? @map("read_at")
  archivedAt  DateTime? @map("archived_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK: сповіщення не може вказати на юзера чужого тенанта
  recipient User   @relation("NotificationRecipient", fields: [tenantId, recipientId], references: [tenantId, id], onDelete: Cascade)

  // Головний запит: інбокс юзера. Сортування updatedAt DESC + tie-breaker по id.
  // Часткові індекси (лічильник непрочитаних і унікальність групи) — сирим SQL
  // у міграції: Prisma їх не вміє
  @@index([tenantId, recipientId, updatedAt(sort: Desc), id])
  @@map("notifications")
}

// Стан інбокса юзера: коли востаннє відкривав панель + лічильник ревізій для realtime.
// Один рядок на юзера, upsert при першій зміні.
model NotificationState {
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  // Момент останнього відкриття панелі — від нього рахується newCount для бейджа
  seenAt    DateTime? @map("seen_at")
  // Монотонний лічильник змін інбокса. У Postgres, а НЕ у Valkey (як presence):
  // інбокс мусить переживати рестарт брокера, присутність — ні
  revision  Int       @default(0)
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("NotificationState", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("notification_states")
}

// Преференси: рядок існує ТІЛЬКИ для явного вибору юзера; дефолт живе в коді
// (NOTIFICATION_TYPE_META) — новий тип не потребує бекфілу для наявних юзерів.
model NotificationPreference {
  tenantId String  @map("tenant_id")
  userId   String  @map("user_id")
  type     String
  // 'in_app' у V1; email/push додаються рядком, не міграцією семантики
  channel  String
  enabled  Boolean

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("NotificationPreference", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId, type, channel])
  @@map("notification_preferences")
}

// Кастомер (контрагент) — базова доменна сутність скелетона (docs/customers.md).
// Одна сутність із дискримінатором kind замість party-моделі (SAP BP / Odoo res.partner):
// party правильна для ERP із кількома типами контрагентів, і Customer → Party мігрується
// перейменуванням, коли зʼявиться другий тип. Наперед — рівень непрямості без споживача.
model Customer {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")

  // Людський ідентифікатор — ЦІЛЕ число, своє в кожного тенанта. Видає сервер
  // із number_sequences, НЕ змінюється і не перевикористовується. Префікс і нулі
  // (`C-000123`) — presentation з number_series, а не частина ідентичності:
  // інакше зміна формату вимагала б переписати всі рядки
  number Int
  kind   CustomerKind   @default(ORGANIZATION)
  // ARCHIVED замість soft delete: «коли і хто» — питання до activities, тому
  // окремої колонки archived_at немає (вона б розійшлася зі status)
  status CustomerStatus @default(ACTIVE)

  // Робоча назва (те, що в гріді). НЕ унікальна: жорсткий констрейнт дає
  // «ТОВ Ромашка 2» замість правильного запису; дублікати ловить merge (беклог)
  name      String
  legalName String? @map("legal_name")

  // Канали рівня організації; персональні — у контактних осіб
  email        String?
  phone        String?
  phoneCountry String? @map("phone_country") @db.Char(2)
  website      String?

  // VAT / ЄДРПОУ / EIN — рядок як прийшов: формати і контрольні суми різні в кожній
  // країні і змінюються, валідація тут = відхилений валідний номер клієнта
  taxId String? @map("tax_id")

  // Валюта розрахунків (ISO 4217) — потрібна ДО білінгу: без неї не показати суми
  currency String @default("USD") @db.Char(3)
  // Мова листів ДО КАСТОМЕРА (аналог SPRAS у SAP KNA1), не локаль співробітника
  locale   String @default("en")

  // Відповідальний менеджер. NULL — «нічий», легальний стан.
  // FK НЕ композитний — та сама причина, що в User.avatarFile: Prisma не вміє
  // SET NULL з переліком колонок і занулила б заодно tenant_id. Захист — RLS
  ownerId String? @map("owner_id")

  // Id у системі-джерелі: ключ ідемпотентності імпорту (повторний запуск оновлює,
  // а не дублює) і зчеплення з інтеграцією
  externalId String? @map("external_id")

  tags  String[] @default([])
  notes String?

  // Адреса V1 — колонки, не окрема таблиця (docs/customers.md §4.3).
  // Коли зʼявляться документи, вони копіюють адресу В СЕБЕ на момент виставлення:
  // рахунок не має мінятися від того, що клієнт переїхав
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  region       String?
  postalCode   String? @map("postal_code")
  country      String? @db.Char(2)

  // Снапшот автора; без FK — юзера можуть видалити, запис лишається
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner          User?             @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts       CustomerContact[]
  // Зустрічі й дзвінки з цим контрагентом: блок «Upcoming» на картці + стрічка
  calendarEvents CalendarEvent[]

  @@unique([tenantId, number])
  @@unique([tenantId, externalId])
  // Опора під композитні FK майбутніх модулів (tickets/invoices → customer)
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt(sort: Desc), id])
  @@index([tenantId, ownerId])
  @@map("customers")
}

enum CustomerKind {
  ORGANIZATION
  PERSON
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Контактна особа кастомера. Вкладена сутність (не самостійний Contact, як у
// Salesforce): не існує без кастомера, і доступ до неї = доступ до нього.
model CustomerContact {
  id         String @id @default(uuid())
  tenantId   String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  customerId String @map("customer_id")

  name         String
  position     String?
  email        String?
  phone        String?
  phoneCountry String? @map("phone_country") @db.Char(2)
  // Рівно один основний на кастомера — гарантує ЧАСТКОВИЙ унікальний індекс
  // (сирим SQL у міграції: Prisma часткові індекси не вміє). Перевірка в сервісі
  // програла б гонці двох вкладок
  isPrimary    Boolean @default(false) @map("is_primary")
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK: контакт не може вказати на кастомера чужого тенанта
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@map("customer_contacts")
}

// Лічильник людських номерів — СПІЛЬНИЙ на всі майбутні нумерації
// (name: 'customer', далі 'invoice', 'ticket'), не таблиця кастомерів.
//
// Чому не CREATE SEQUENCE: послідовність одна на БД (номери скачуть між тенантами,
// витікає обсяг сусіда), вона поза RLS, і головне — nextval НЕ відкочується, тобто
// дає дірки в нумерації. Тут інкремент живе в тій самій транзакції, що й сам рядок,
// тому відкат забирає і номер. Ціна — блокування рядка до коміту (створення
// серіалізується в межах тенанта); для документів, де пропуск номера — питання від
// податкової, це саме те, що потрібно.
model NumberSequence {
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  name     String
  // Бакет скидання: '' — наскрізна нумерація (майстер-дані), '2026' / '2026-09' —
  // документи з YEARLY/MONTHLY. У ключі з першого дня: додати колонку в PK згодом
  // дорожче, ніж завести її порожньою зараз
  scope    String @default("")

  lastValue Int @default(0) @map("last_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, name, scope])
  @@map("number_sequences")
}

// Конфіг нумерації тенанта. Окремо від лічильника свідомо: у них різні життєві
// цикли — конфіг редагує людина раз на рік, лічильник блокується на КОЖНІЙ
// видачі. Рядок існує тільки коли тенант змінив дефолт (NUMBER_SERIES_DEFAULTS
// у контрактах) — той самий патерн, що в notification_preferences.
model NumberSeries {
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  name     String

  prefix      String            @default("")
  padding     Int               @default(0)
  // Перший номер у КОЖНОМУ новому періоді. На вже початий лічильник не впливає —
  // для нього є окрема монотонна операція «наступний номер = N»
  startValue  Int               @default(1) @map("start_value")
  resetPeriod NumberResetPeriod @default(NONE) @map("reset_period")

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, name])
  @@map("number_series")
}

enum NumberResetPeriod {
  NONE
  YEARLY
  MONTHLY
}

// Inbox-патерн для ідемпотентності обробки job-ів (див. libs/shared JobInboxService).
// Інфра-таблиця: БЕЗ tenant_id і БЕЗ RLS — маркер ідемпотентності глобальний.
model ProcessedJob {
  id          String   @id // pg-boss job id
  jobName     String   @map("job_name")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_jobs")
}

// ============================================================================
// Календар (docs/calendar.md). Іменування з кваліфікатором: слово Event у цьому
// репозиторії зайняте messaging-повідомленнями, socket-подіями і журналом.
// ============================================================================

model CalendarEvent {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")

  title       String
  description String?
  location    String?

  kind       CalendarEventKind       @default(MEETING)
  // CANCELLED замість soft delete: учасник мусить побачити «скасовано», а не
  // «зникло». Тому скасування — окремий ендпоінт (подія), а DELETE лишається
  // виправленням щойно зробленої помилки
  status     CalendarEventStatus     @default(CONFIRMED)
  visibility CalendarEventVisibility @default(DEFAULT)
  // TRANSP із RFC 5545: чи рахувати подію зайнятістю при перевірці накладань
  busy       Boolean                 @default(true)

  // UTC-інстанти. ends_at ЕКСКЛЮЗИВНИЙ: подія — пів-інтервал [starts_at, ends_at),
  // тому перетин із вікном — starts_at < :to AND ends_at > :from (обидва строгі).
  // Одноденна all-day = [06.09 00:00, 07.09 00:00) у time_zone події
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")
  // IANA-зона, В ЯКІЙ час задали (Europe/Kyiv), а НЕ offset: offset — властивість
  // моменту, після переходу на зимовий час він інший, і «щовівторка о 10:00»
  // поїхало б на годину. Потрібна і для all-day, і для повторень (CAL-4)
  timeZone String   @map("time_zone")
  // true = час ігнорується: межі нормалізовані до опівночі в time_zone події,
  // а рендер бере ДАТУ в зоні ПОДІЇ, не глядача (docs/calendar.md §6.2)
  allDay   Boolean  @default(false) @map("all_day")

  // Організатор. NULLABLE + SetNull — як Customer.owner (рішення 2026-09-06):
  // історія команди мусить пережити звільнення людини, а Restrict перетворив би
  // офбординг на квест. Подію без організатора редагує ADMIN — ЄДИНИЙ випадок,
  // коли він має права на чужу подію
  ownerId String? @map("owner_id")

  // Контекст CRM. Конкретна колонка, а не поліморфний лінк: другого типу
  // контрагента поки немає, а рівень непрямості без споживача — борг (та сама
  // логіка, що відкинула party-модель у customers.md §2)
  customerId String? @map("customer_id")

  // Снапшот автора; без FK — юзера можуть видалити, подія лишається
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // FK НЕ композитний — та сама причина, що в Customer.owner і User.avatarFile:
  // Prisma не вміє SET NULL з переліком колонок і занулила б заодно tenant_id.
  // Крос-tenant захист — RLS на обох таблицях
  owner     User?                   @relation("CalendarEventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // FK НЕ композитний — рівно та сама грабля, що в Customer.owner: Prisma не вміє
  // SET NULL з переліком колонок і занулила б заодно tenant_id (prisma validate
  // це навіть попереджає). Крос-tenant захист — RLS на обох таблицях.
  // Саме SetNull, а не Restrict: «зустріч, яка була» не має зникати чи блокувати
  // видалення картки клієнта — журнал переживає сутність
  customer  Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attendees CalendarEventAttendee[]
  reminders CalendarReminder[]

  // Опора під композитні FK дочірніх таблиць
  @@unique([tenantId, id])
  // Головний запит модуля — вікно
  @@index([tenantId, startsAt, endsAt])
  @@index([tenantId, ownerId, startsAt])
  @@index([tenantId, customerId, startsAt])
  @@map("calendar_events")
}

enum CalendarEventKind {
  MEETING
  CALL
  DEADLINE
  OUT_OF_OFFICE
  OTHER
}

enum CalendarEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum CalendarEventVisibility {
  DEFAULT
  PRIVATE
}

// Учасник події. У V1 — тільки юзер тенанта: зовнішній учасник вимагає листа,
// а email-канал у цьому ході свідомо не вмикаємо (CAL-3).
model CalendarEventAttendee {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  eventId  String @map("event_id")
  userId   String @map("user_id")

  role        CalendarAttendeeRole     @default(REQUIRED)
  // PARTSTAT із RFC 5545
  response    CalendarAttendeeResponse @default(NEEDS_ACTION)
  // Коли відповів — потрібне організатору («досі не відповів третій день»)
  respondedAt DateTime?                @map("responded_at")
  comment     String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитні FK: учасник не може вказати ні на подію, ні на юзера чужого тенанта
  event  CalendarEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Cascade)
  user   User          @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  // Двічі запросити ту саму людину неможливо
  @@unique([tenantId, eventId, userId])
  // «Мій календар» = події, де я учасник: цей індекс несе головний список
  @@index([tenantId, userId])
  @@map("calendar_event_attendees")
}

enum CalendarAttendeeRole {
  REQUIRED
  OPTIONAL
}

enum CalendarAttendeeResponse {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

// ДЕКЛАРАЦІЯ нагадування («за 30 хв»), персональна: організатор і учасник мають
// у тій самій події різні нагадування (як reminders.overrides у Google).
// Момент спрацювання тут НЕ зберігається — він рахується і матеріалізується
// в scheduled_notifications (docs/calendar.md §8.1). Пара «конфіг + розрахований
// стан» — той самий поділ, що number_series / number_sequences.
model CalendarReminder {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  eventId  String @map("event_id")
  userId   String @map("user_id")

  // Хвилини ДО початку, а не абсолютний момент: подію переносять, і абсолютний
  // час довелося б перераховувати на кожен зсув (а частину — забути)
  minutesBefore Int    @map("minutes_before")
  // Ключ (type, channel) закладений під email; у V1 живий рівно 'in_app'
  channel       String @default("in_app")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  CalendarEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Cascade)
  user   User          @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  // Два однакові нагадування на ту саму подію — помилка вводу, не дані
  @@unique([tenantId, eventId, userId, minutesBefore, channel])
  @@index([tenantId, eventId])
  @@map("calendar_reminders")
}

// ============================================================================
// Відкладені сповіщення — СПІЛЬНА інфраструктура (docs/notifications.md
// § «Обмеження V1 / беклог», roadmap §2.1), а не частина календаря: жодного
// calendar_ у назвах. Календар — її перший споживач.
//
// Чому не pg-boss із startAfter (docs/calendar.md §8.2): pgboss.* поза RLS —
// тенант не має права читати таблицю черги, тож ні показати «мої нагадування»,
// ні скасувати їх із доменного коду було б неможливо. Плюс ретеншн черги,
// скасування як друге джерело правди і гонки при перепрануванні.
// ============================================================================

model ScheduledNotification {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")

  // Коли доставити. Сканер бере рядки з fire_at <= now() атомарним claim-ом
  fireAt    DateTime @map("fire_at")
  // Ключ ідемпотентності МАТЕРІАЛІЗАЦІЇ: 'calendar_reminder:{id}:{occurrenceStart}'.
  // Повторна матеріалізація (ретрай, дві вкладки) не плодить дублів
  dedupeKey String   @map("dedupe_key")

  // Форма рядка дзеркалить notifications: сканер просто передає це в recorder
  recipientId String  @map("recipient_id")
  type        String
  payload     Json
  targetKind  String? @map("target_kind")
  targetId    String? @map("target_id")
  groupKey    String? @map("group_key")
  actorType   String  @default("system") @map("actor_type")
  actorId     String? @map("actor_id")
  actorLabel  String? @map("actor_label")

  // Захоплено сканером. Окремо від delivered_at: захоплений рядок уже в роботі,
  // і перепланування його НЕ видаляє (доставка — правда про минуле)
  claimedAt     DateTime? @map("claimed_at")
  deliveredAt   DateTime? @map("delivered_at")
  // 'stale' — дозріло більш ніж grace тому (воркер лежав). Нагадування «зустріч
  // за 30 хв», отримане через годину після початку, гірше за мовчання
  skippedReason String?   @map("skipped_reason")

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient User   @relation("ScheduledNotificationRecipient", fields: [tenantId, recipientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, recipientId, fireAt])
  // Частковий індекс сканера (WHERE ще не доставлено) — сирим SQL у міграції
  @@map("scheduled_notifications")
}

// ============================================================================
// AI-асистент (docs/ai-assistant-plan.md, фаза AI-0).
//
// Розмова ОСОБИСТА: RLS тут дає межу ТЕНАНТА, а межу людини тримає сервіс —
// той самий поділ, що для приватних каналів чату і приватних подій календаря
// («RLS — межа тенанта, а не учасника»). Тому композитний FK на users є, а
// жодної ролі в схемі немає: ADMIN не отримує доступу за побудовою.
// ============================================================================

model AiConversation {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  userId   String @map("user_id")

  // RETIRED замість видалення: «нова розмова» скидає КОНТЕКСТ, а не історію.
  // Активна рівно одна на юзера — це частковий унікальний індекс у міграції
  // (Prisma їх не вміє), він же арбітр гонки двох вкладок на першому повідомленні
  status AiConversationStatus @default(ACTIVE)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastMessageAt DateTime? @map("last_message_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK + Cascade: розмова належить людині, і разом із нею й зникає.
  // SetNull тут був би безглуздим — безхазяйна особиста розмова нікому не видима
  user     User        @relation("AiConversationOwner", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  messages AiMessage[]

  // Опора під композитний FK повідомлень
  @@unique([tenantId, id])
  @@index([tenantId, userId, status])
  @@map("ai_conversations")
}

enum AiConversationStatus {
  ACTIVE
  RETIRED
}

model AiMessage {
  id             String @id @default(uuid())
  tenantId       String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  conversationId String @map("conversation_id")

  // Серверний порядок у межах розмови. НЕ created_at: порядок, курсор і детектор
  // дірок — це одне рішення, і мітка часу не дає жодного з них (docs/chat.md §4.3)
  seq Int

  role   AiMessageRole
  // Статус відповіді — він же ЯКІР ІДЕМПОТЕНТНОСТІ генерації: воркер працює лише
  // над PENDING/STREAMING і мовчки виходить на COMPLETE. Саме тому тут НЕ
  // використовується MessageInboxService.runOnce — він заблокував би легальний
  // ретрай після тимчасової відмови провайдера (design.md)
  status AiMessageStatus

  // Порожній рядок, а не null: відповідь у роботі вже має вміст, просто неповний
  content   String  @default("")
  // Код із контракту ApiError (AI_PROVIDER_UNAVAILABLE тощо) — текст рендерить фронт
  errorCode String? @map("error_code")

  // Резерв під AI-1 (облік токенів). Nullable-колонки зараз коштують нічого і
  // економлять міграцію на таблиці, у якої на той час уже будуть рядки
  model            String?
  promptTokens     Int?    @map("prompt_tokens")
  completionTokens Int?    @map("completion_tokens")
  // Підмножина promptTokens (не додається зверху) — скільки токенів промпту прочитано
  // з кешу провайдера. Раніше лише в лозі воркера (ai-1a); ai-1d зберігає окремою
  // колонкою й рахує в ai_usage_counters — єдиний спосіб побачити, чи працює кеш
  cachedPromptTokens Int? @map("cached_prompt_tokens")

  // Версія корпусу знань, якою відповідали (ai-1b, design.md D7): хеш артефакту
  // `pnpm ai:knowledge`. Повний промпт НЕ зберігається — він відтворюється з цієї
  // версії (git), коду інструкції, збереженої історії й питання (ai-assistant.md
  // §11.6). Пише `claim()` у тому ж фенсингованому UPDATE, що й `model`; NULL —
  // питання юзера або відповідь, згенерована до ai-1b
  knowledgeVersion String? @map("knowledge_version")

  // ВЛАСНІСТЬ ГЕНЕРАЦІЇ (AI-0.1, design.md D1). Захоплюється умовним UPDATE, що
  // збільшує `attempt` і виставляє оренду; кожен наступний запис — теж умовний
  // UPDATE з `WHERE attempt = <моя спроба>`. Нуль оновлених рядків = спробу
  // випереджено — генерація припиняється мовчки, нічого не фіналізується
  attempt Int @default(0)
  // Оренда власності: PENDING отримує її при створенні (design.md D3), STREAMING —
  // при захопленні. NULL або минула — відповідь "покинута", закривається на
  // наступному читанні розмови, а не сканером-кроном
  leaseExpiresAt DateTime? @map("lease_expires_at")
  // Стрічка знає позицію потоку: скільки кадрів дельт уже увійшло в `content`.
  // Разом з `attempt` це дає клієнту точку, з якої продовжувати після одного
  // перечитування, без вгадування по `chunkSeq === 0` (design.md D6)
  chunkCount Int @default(0) @map("chunk_count")
  // Факт Stop, записаний у БД РАНІШЕ за pub/sub-сигнал (design.md D4): доставляє
  // скасування, навіть якщо сигнал загублено або надійшов до підписки воркера
  cancelRequestedAt DateTime? @map("cancel_requested_at")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  // Арбітр порядку: він же індекс під читання стрічки розмови
  @@unique([tenantId, conversationId, seq])
  @@map("ai_messages")
}

enum AiMessageRole {
  USER
  ASSISTANT
}

// ============================================================================
// Квоти токенів асистента (ai-1d, docs/ai-assistant.md §8, design.md D1/D2).
//
// Рівно один рядок на (tenant, user, period) — période = початок доби UTC.
// Тенантний підсумок НЕ окремий рядок: рахується агрегатом SUM по рядках
// тенанта за період у момент перевірки — другий писаний рядок означав би
// другий шлях запису, який мусив би довіку не розійтись із першим (design.md D1).
// ============================================================================

model AiUsageCounter {
  id          String   @id @default(uuid())
  tenantId    String   @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  userId      String   @map("user_id")
  // Початок доби UTC, якій належить рядок (design.md D2)
  periodStart DateTime @map("period_start")

  promptTokens Int @default(0) @map("prompt_tokens")
  // Підмножина promptTokens, НЕ додається зверху (design.md D5) — лише видимість кеша
  cachedPromptTokens Int @default(0) @map("cached_prompt_tokens")
  completionTokens   Int @default(0) @map("completion_tokens")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("AiUsageCounterOwner", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  // Арбітр атомарного інкременту (upsert ... ON CONFLICT) і водночас індекс під
  // перевірку/агрегат тенанта за період (design.md D4)
  @@unique([tenantId, userId, periodStart])
  @@index([tenantId, periodStart])
  @@map("ai_usage_counters")
}

enum AiMessageStatus {
  PENDING
  STREAMING
  COMPLETE
  FAILED
  CANCELLED
}

// ============================================================================
// Чат (CHAT-0.1). Повна модель і рішення — docs/chat.md §4.2, §4.3, §6;
// що з колонок заводиться зараз, а що чекає своєї фази — §7.4 і design.md D7:
// одразу лише те, чия поява потім вимагала б backfill-у або зміни вже написаних
// запитів. Тому тут немає ні channel_id, ні direction, ні customer_id —
// їх додасть фаза, яка їх читає.
//
// RLS тут — межа ТЕНАНТА. Межу учасника (приватний канал не видно навіть ADMIN)
// тримає сервіс: те саме рішення, що для приватних подій календаря і AI-розмов
// («RLS — межа тенанта, а не учасника», docs/chat.md §5 п. 6).
// ============================================================================

model Conversation {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")

  // Явна дискримінанта, а НЕ похідна від каналу: від неї залежать правила доступу
  kind   ConversationKind   @default(INTERNAL)
  // ЗВЕТЬСЯ access, а не visibility: `visibility` уже зайняте на ChatMessage у
  // зовсім іншому значенні (публічна репліка vs внутрішня нотатка), і дві
  // однойменні колонки з різною семантикою в сусідніх таблицях — найдешевший
  // спосіб отримати помилку в запиті доступу (docs/chat.md §4.1).
  // Створюється ЛИШЕ 'private'; гілка 'tenant' у резолвері не написана, доки не
  // зʼявиться сценарій «оголошення для всіх» (§6)
  access String             @default("private")
  status ConversationStatus @default(OPEN)

  // Дефолтний канал тенанта («General»). Колонка, а не пошук по title: назву
  // колись перейменують, і пошук зламається мовчки. Рівно один на тенант —
  // це частковий унікальний індекс у міграції (design.md D3)
  isDefault Boolean @default(false) @map("is_default")

  title String?

  // --- денормалізація під список розмов (docs/chat.md §4.3) ---
  // Лічильник порядку: інкремент цього рядка І Є видачею seq повідомленню.
  // Він же серіалізує вставки в МЕЖАХ розмови (рядок залочено) і лишає різні
  // розмови повністю паралельними
  lastSeq            Int       @default(0) @map("last_seq")
  lastMessageAt      DateTime? @map("last_message_at")
  // Тільки для TEXT-реплік. Системний запис сюди НЕ пише: прев'ю — текстова
  // колонка, а в системного запису тексту немає за доктриною (type + params,
  // рендер i18next). NULL = «повідомлень ще немає» (design.md D5)
  lastMessagePreview String?   @map("last_message_preview")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     ChatMessage[]

  // Опора під композитні FK дочірніх таблиць
  @@unique([tenantId, id])
  // Список розмов — найгарячіший запит модуля: «мої», завжди свіжі згори
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

enum ConversationKind {
  INTERNAL
  CUSTOMER
}

enum ConversationStatus {
  OPEN
  PENDING
  SNOOZED
  RESOLVED
}

// Хто «в розмові» + персональний стан прочитаного. Прочитане — КУРСОР, а не
// прапорець на кожному повідомленні: прапорець дав би N×M рядків і все одно не
// відповів би на питання «докуди дочитав кожен» (docs/chat.md §4.3)
model ConversationParticipant {
  conversationId String @map("conversation_id")
  tenantId       String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  userId         String @map("user_id")

  role String @default("member")

  // seq на момент вступу: роздільник «до вашого приєднання» в стрічці. Історію
  // до вступу видно ВСЮ — людину додають у канал заради контексту (§4.4)
  joinSeq Int @default(0) @map("join_seq")

  lastReadSeq Int       @default(0) @map("last_read_seq")
  lastReadAt  DateTime? @map("last_read_at")
  // Денормалізований лічильник: бейдж у списку читається без COUNT
  unreadCount Int       @default(0) @map("unread_count")

  joinedAt DateTime  @default(now()) @map("joined_at")
  // Рядок НЕ видаляємо: видалений забрав би з собою авторство системних записів
  // («X додав Y») і можливість показати, хто був у каналі раніше. Доступ —
  // left_at IS NULL
  leftAt   DateTime? @map("left_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитні FK: учасник не може вказати ні на розмову, ні на юзера чужого тенанта
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  user         User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([conversationId, userId])
  // «Мої розмови» і перевірка доступу
  @@index([tenantId, userId, leftAt])
  @@map("conversation_participants")
}

// Репліка, внутрішня нотатка і системний запис — ОДНА таблиця: одна стрічка =
// один курсор. Злиття двох пагінованих фідів на клієнті дає дірки на межах
// сторінок (docs/chat.md §4.7)
model ChatMessage {
  id             String @id @default(uuid())
  tenantId       String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  conversationId String @map("conversation_id")

  // Монотонний порядковий номер У МЕЖАХ РОЗМОВИ — джерело порядку, курсора і
  // детектора дірок. НЕ created_at: мітка часу не дає жодного з трьох (§4.3)
  seq Int

  kind       MessageKind
  visibility MessageVisibility @default(PUBLIC)

  // user | system (customer/bot зʼявляться з каналами). Рядок, а не enum —
  // за docs/chat.md §4.2
  senderType   String  @map("sender_type")
  senderUserId String? @map("sender_user_id")
  // Снапшот підпису відправника — як actorLabel в activities: юзера можуть
  // деактивувати чи перейменувати, транскрипт мусить лишитись читабельним
  senderLabel  String? @map("sender_label")

  // NULL для kind = SYSTEM: у системного запису тексту немає
  body    String? @db.Text
  // Для SYSTEM — { type, params }, рендер через i18next
  payload Json    @default("{}")

  // Ідемпотентність надсилання. Арбітр — частковий UNIQUE у міграції, не
  // перевірка в коді: перевірка програє гонці двох запитів (§4.5)
  clientMessageId String? @map("client_message_id")

  // У цьому зрізі завжди SENT. Колонка все одно є: у CHAT-2 вона приймає QUEUED
  // від канального адаптера, а без неї футер бульбашки довелося б писати вдруге
  status MessageStatus @default(SENT)

  // М'яке видалення: «видалено для всіх» лишає рядок, щоб нумерація seq не мала дірок
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  // FK НЕ композитний — та сама грабля, що в CalendarEvent.owner: Prisma не вміє
  // SET NULL з переліком колонок і занулила б заодно tenant_id. Саме SetNull:
  // транскрипт переживає видалення людини, підпис лишається в sender_label
  sender       User?        @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  // Арбітр порядку — він же індекс під читання стрічки. Окремого DESC-індексу
  // немає свідомо: Postgres сканує btree у зворотному напрямку так само дешево,
  // а це найбільша таблиця системи (docs/chat.md §5 п. 5)
  @@unique([tenantId, conversationId, seq])
  @@map("chat_messages")
}

enum MessageKind {
  TEXT
  SYSTEM
}

enum MessageVisibility {
  PUBLIC
  INTERNAL
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// AI-2a foundation: tenant-owned retrieval index. Global publishing is a later
// control-plane step; tenant_id stays required, with the standard RLS boundary.
model AiKnowledgeSource {
  id             String   @id @default(uuid())
  tenantId       String   @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  key            String
  product        String
  isEnabled      Boolean  @default(false) @map("is_enabled")
  // Ingest stages a complete revision, then atomically switches this pointer.
  // Null means unpublished. No automatic publication on document/chunk insert.
  activeRevision String?  @map("active_revision")
  ingestRunId String? @map("ingest_run_id")
  ingestStatus String @default("idle") @map("ingest_status")
  ingestStartedAt DateTime? @map("ingest_started_at")
  manifestHash String? @map("manifest_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents AiKnowledgeDocument[]

  @@unique([tenantId, id])
  @@unique([tenantId, product, key])
  @@map("ai_knowledge_sources")
}

model AiKnowledgeDocument {
  id          String   @id @default(uuid())
  tenantId    String   @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  sourceId    String   @map("source_id")
  revision    String
  canonicalId String   @map("canonical_id")
  path        String
  title       String
  language    String
  // Application roles after source-specific audience mapping; empty denies all.
  audience    Role[]   @default([])
  contentHash String   @map("content_hash") @db.Char(64)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source AiKnowledgeSource  @relation(fields: [tenantId, sourceId], references: [tenantId, id], onDelete: Cascade)
  chunks AiKnowledgeChunk[]

  @@unique([tenantId, id])
  @@unique([tenantId, sourceId, revision, canonicalId, language], map: "ai_knowledge_documents_identity_key")
  @@map("ai_knowledge_documents")
}

model AiKnowledgeChunk {
  id             String                      @id @default(uuid())
  tenantId       String                      @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  documentId     String                      @map("document_id")
  ordinal        Int
  heading        String
  content        String
  contentHash    String                      @map("content_hash") @db.Char(64)
  tokenCount     Int                         @map("token_count")
  // v1 profile is fixed in SQL too. Changing models requires a new index version.
  embeddingModel String                      @default("text-embedding-3-small") @map("embedding_model")
  embedding      Unsupported("vector(1536)")
  createdAt      DateTime                    @default(now()) @map("created_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document AiKnowledgeDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, documentId, ordinal])
  @@index([tenantId, contentHash, embeddingModel], map: "ai_knowledge_chunks_tenant_hash_idx")
  @@map("ai_knowledge_chunks")
}
