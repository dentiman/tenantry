generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// MT-1: tenant (перейменовано з Organization 2026-07-16 — «організація» лишається вільним
// доменним словом для споживачів скелетона). Single-tenant = рівно один рядок (N=1).
// Політика RLS (MT-2): tenant бачить ЛИШЕ власний рядок (id = current_setting).
model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique // під логін по slug (MT-3) і піддомени (MT-4)
  name      String
  // suspend/resume тенанта: login відмовляє всім юзерам неактивного tenant-а
  isActive  Boolean  @default(true) @map("is_active")
  // Дефолтна локаль для нових юзерів тенанта
  locale    String   @default("en")
  // Валюта розрахунків воркспейсу (ISO 4217) — дефолт для нових кастомерів і
  // для будь-якого показу сум. КОЛОНКА, а не settings Json: закритий формат,
  // і платформа колись питатиме «усі тенанти з currency=EUR» (docs/workspace-settings.md)
  currency  String   @default("USD") @db.Char(3)
  // Гнучкі налаштування (feature-flags, UI-преференси); типізовані — окремими колонками
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                   User[]
  refreshTokens           RefreshToken[]
  files                   File[]
  attachments             Attachment[]
  activities              Activity[]
  activityLinks           ActivityLink[]
  notifications           Notification[]
  notificationStates      NotificationState[]
  notificationPreferences NotificationPreference[]
  customers               Customer[]
  customerContacts        CustomerContact[]
  numberSequences         NumberSequence[]
  numberSeries            NumberSeries[]
  calendarEvents          CalendarEvent[]
  calendarEventAttendees  CalendarEventAttendee[]
  calendarReminders       CalendarReminder[]
  scheduledNotifications  ScheduledNotification[]

  @@map("tenants")
}

// Base user model for the CRM template
model User {
  id           String    @id @default(uuid())
  // MT-1: заповнюється DB-default-ом current_setting('app.tenant_id') — доменний код його НЕ передає
  tenantId     String    @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  email        String
  name         String?
  passwordHash String?   @map("password_hash")
  role         Role      @default(USER)
  isActive     Boolean   @default(true) @map("is_active")
  // I18N-3: локаль для server-rendered тексту (email); UI-перемикач мови — I18N-4
  locale       String    @default("en")
  // Календар: IANA-зона юзера (docs/calendar.md §6.1). NULL = «як в організації»
  // (settings.calendar.timeZone). Окремо від locale свідомо: локаль задає ФОРМАТ,
  // зона — який саме це момент; людина в Берліні з англійським UI — норма
  timeZone     String?   @map("time_zone")
  // Телефон завжди в E.164 (валідує PhoneNumberSchema в contracts). phoneCountry потрібен
  // окремо, бо за кодом країни номер не відновлюється однозначно: +1 — це US, CA і десяток
  // карибських країн, і без збереженого вибору UI показав би не той прапор при редагуванні
  phone        String?
  phoneCountry String?   @map("phone_country") @db.Char(2)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  // Демо-споживач файлової підсистеми (Files v1)
  avatarFileId String?   @map("avatar_file_id")
  // RT-3: найпізніший момент, коли система ТОЧНО знала про живе socket-зʼєднання юзера
  // (high-water mark, а НЕ «момент дисконекту»: у режимах відмов дисконект не настає
  // взагалі). NULL — жодного разу не підключався. Пишеться ТІЛЬКИ presence-шаром
  // (LastSeenWriter) сирим UPDATE-ом — Prisma-update підняв би @updatedAt і сесія
  // виглядала б як редагування профілю. З доменного коду не чіпати.
  lastSeenAt   DateTime? @map("last_seen_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens           RefreshToken[]
  // Персональний інбокс (docs/notifications.md): іде разом із юзером — це його
  // особисті дані, а не журнал (журнал — activities, він переживає видалення)
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationState       NotificationState?       @relation("NotificationState")
  notificationPreferences NotificationPreference[] @relation("NotificationPreference")
  // FK НЕ композитний свідомо: onDelete SetNull з композитним FK занулив би і tenant_id
  // (Prisma не вміє SET NULL з переліком колонок). Крос-tenant захист — RLS на обох таблицях.
  avatarFile              File?                    @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  uploadedFiles           File[]                   @relation("UploadedFiles")
  ownedCustomers          Customer[]               @relation("CustomerOwner")
  organizedEvents         CalendarEvent[]          @relation("CalendarEventOwner")
  eventAttendances        CalendarEventAttendee[]
  calendarReminders       CalendarReminder[]
  scheduledNotifications  ScheduledNotification[]  @relation("ScheduledNotificationRecipient")

  // Email унікальний У МЕЖАХ tenant-а (та сама людина у двох тенантах = два акаунти)
  @@unique([tenantId, email])
  // Опора для композитних FK з інших таблиць
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("users")
}

enum Role {
  ADMIN
  USER
}

model RefreshToken {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK: токен не може вказати на юзера чужого tenant-а (FK-перевірки обходять RLS)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("refresh_tokens")
}

// Файлова підсистема (Files v1): метадані об'єктів S3-сховища.
// Байти живуть у S3 (dev: SeaweedFS), тут — тільки метадані і статус двофазного upload-у:
// PENDING (виданий presigned PUT, байтів може ще не бути) → READY (complete підтвердив HeadObject).
// PENDING старші за поріг прибирає cron files.cleanup-orphans (S3-об'єкт + рядок).
model File {
  id           String     @id @default(uuid())
  tenantId     String     @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  // Ключ у бакеті: {tenantId}/{yyyy}/{mm}/{uuid}[.ext] — НЕ оригінальна назва (MT-1: tenant-префікс)
  key          String     @unique
  filename     String
  mimeType     String     @map("mime_type")
  size         Int
  status       FileStatus @default(PENDING)
  // Мініатюра зображення (worker, sharp); для не-зображень завжди null
  thumbnailKey String?    @map("thumbnail_key")
  uploadedById String?    @map("uploaded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // FK не композитний: onDelete SetNull (див. коментар у User.avatarFile)
  uploadedBy  User?        @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: SetNull)
  attachments Attachment[]
  avatarOf    User[]       @relation("UserAvatar")

  // Опора для композитних FK (attachments)
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  // Глобальний індекс для системного cron-у cleanup-orphans (BYPASSRLS, шукає PENDING по всіх тенантах)
  @@index([status, createdAt])
  @@map("files")
}

enum FileStatus {
  PENDING
  READY
}

// Універсальна прив'язка файлу до доменної сутності (customers/tickets у майбутніх фазах).
// Полиморфний (entityType — рядок), тому без FK на сутність; цілісність — відповідальність домену.
model Attachment {
  id         String   @id @default(uuid())
  tenantId   String   @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  fileId     String   @map("file_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK: attachment не може вказати на файл чужого tenant-а
  file   File   @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, fileId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
  @@map("attachments")
}

// MT-3: identity CONTROL PLANE (apps/platform-api) — оператори платформи.
// СВІДОМО окрема від users: інший login-флоу, інший JWT-secret, без tenant_id.
// Доступ ТІЛЬКИ ролі saas_platform (міграція робить REVOKE від saas_app —
// tenant-api цю таблицю навіть прочитати не може).
model PlatformUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_users")
}

// Журнал бізнес-подій (docs/activity-log.md). Append-only: без updatedAt,
// без UPDATE/DELETE через API. Текст НЕ зберігається — type + payload,
// рендерить фронт (i18n-доктрина: бекенд — коди).
model Activity {
  id         String   @id @default(uuid())
  tenantId   String   @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  // Закритий enum у контрактах (ACTIVITY_TYPES); у БД — рядок (нові типи без міграції)
  type       String
  actorType  String   @map("actor_type") // 'user' | 'system'
  // БЕЗ FK на users свідомо: снапшот — юзера можуть видалити, фід мусить жити
  actorId    String?  @map("actor_id")
  actorLabel String?  @map("actor_label") // снапшот (email/ім'я) на момент події
  // Параметри для рендеру: снапшот-label-и + {kind, id}-референси (схема — по типу)
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  links  ActivityLink[]

  // Опора для композитного FK з activity_links
  @@unique([tenantId, id])
  // Tenant-wide фід + tie-breaker курсора
  @@index([tenantId, createdAt(sort: Desc), id])
  @@map("activities")
}

// Прив'язка події до сутностей, яких вона стосується (1 подія → N сутностей).
// Поліморфний (entityType — рядок), без FK на сутність — як attachments.
model ActivityLink {
  activityId String  @map("activity_id")
  tenantId   String  @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  entityType String  @map("entity_type") // 'user' | 'customer' | 'ticket' …
  entityId   String  @map("entity_id")
  // Семантика зв'язку: 'subject' | 'target' | 'source' | 'context'; NULL коли
  // неоднозначності немає. Словник валідує Zod-схема типу події, не БД
  role       String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK: лінк не може вказати на активність чужого tenant-а
  activity Activity @relation(fields: [tenantId, activityId], references: [tenantId, id], onDelete: Cascade)

  @@id([activityId, entityType, entityId])
  // Головний запит: фід сутності
  @@index([tenantId, entityType, entityId])
  @@map("activity_links")
}

// Персональний інбокс користувача (docs/notifications.md). На відміну від Activity —
// рядок МУТАБЕЛЬНИЙ: read_at/archived_at/колапс. Текст не зберігається: type + payload,
// рендерить фронт через i18next (та сама i18n-доктрина, що в activities).
model Notification {
  id          String    @id @default(uuid())
  tenantId    String    @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  // Кому. NOT NULL завжди: broadcast без отримувача — поза скопом V1
  recipientId String    @map("recipient_id")
  // Закритий enum у контрактах (NOTIFICATION_TYPES); у БД — рядок (нові типи без міграції)
  type        String
  payload     Json
  // Одна канонічна ціль кліку (на відміну від activity_links, яких буває N).
  // Nullable: буває сповіщення без переходу (welcome)
  targetKind  String?   @map("target_kind")
  targetId    String?   @map("target_id")
  // Ключ колапсу: N однотипних подій зливаються в один НЕПРОЧИТАНИЙ рядок
  groupKey    String?   @map("group_key")
  groupCount  Int       @default(1) @map("group_count")
  // Актор — та сама форма, що в activities (снапшот, без FK на users)
  actorType   String    @map("actor_type")
  actorId     String?   @map("actor_id")
  actorLabel  String?   @map("actor_label")
  createdAt   DateTime  @default(now()) @map("created_at")
  // Час ОСТАННЬОЇ появи: по ньому сортується фід, його ж рухає колапс
  updatedAt   DateTime  @updatedAt @map("updated_at")
  readAt      DateTime? @map("read_at")
  archivedAt  DateTime? @map("archived_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK: сповіщення не може вказати на юзера чужого тенанта
  recipient User   @relation("NotificationRecipient", fields: [tenantId, recipientId], references: [tenantId, id], onDelete: Cascade)

  // Головний запит: інбокс юзера. Сортування updatedAt DESC + tie-breaker по id.
  // Часткові індекси (лічильник непрочитаних і унікальність групи) — сирим SQL
  // у міграції: Prisma їх не вміє
  @@index([tenantId, recipientId, updatedAt(sort: Desc), id])
  @@map("notifications")
}

// Стан інбокса юзера: коли востаннє відкривав панель + лічильник ревізій для realtime.
// Один рядок на юзера, upsert при першій зміні.
model NotificationState {
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  // Момент останнього відкриття панелі — від нього рахується newCount для бейджа
  seenAt    DateTime? @map("seen_at")
  // Монотонний лічильник змін інбокса. У Postgres, а НЕ у Valkey (як presence):
  // інбокс мусить переживати рестарт брокера, присутність — ні
  revision  Int       @default(0)
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("NotificationState", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("notification_states")
}

// Преференси: рядок існує ТІЛЬКИ для явного вибору юзера; дефолт живе в коді
// (NOTIFICATION_TYPE_META) — новий тип не потребує бекфілу для наявних юзерів.
model NotificationPreference {
  tenantId String  @map("tenant_id")
  userId   String  @map("user_id")
  type     String
  // 'in_app' у V1; email/push додаються рядком, не міграцією семантики
  channel  String
  enabled  Boolean

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("NotificationPreference", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId, type, channel])
  @@map("notification_preferences")
}

// Кастомер (контрагент) — базова доменна сутність скелетона (docs/customers.md).
// Одна сутність із дискримінатором kind замість party-моделі (SAP BP / Odoo res.partner):
// party правильна для ERP із кількома типами контрагентів, і Customer → Party мігрується
// перейменуванням, коли зʼявиться другий тип. Наперед — рівень непрямості без споживача.
model Customer {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")

  // Людський ідентифікатор — ЦІЛЕ число, своє в кожного тенанта. Видає сервер
  // із number_sequences, НЕ змінюється і не перевикористовується. Префікс і нулі
  // (`C-000123`) — presentation з number_series, а не частина ідентичності:
  // інакше зміна формату вимагала б переписати всі рядки
  number Int
  kind   CustomerKind   @default(ORGANIZATION)
  // ARCHIVED замість soft delete: «коли і хто» — питання до activities, тому
  // окремої колонки archived_at немає (вона б розійшлася зі status)
  status CustomerStatus @default(ACTIVE)

  // Робоча назва (те, що в гріді). НЕ унікальна: жорсткий констрейнт дає
  // «ТОВ Ромашка 2» замість правильного запису; дублікати ловить merge (беклог)
  name      String
  legalName String? @map("legal_name")

  // Канали рівня організації; персональні — у контактних осіб
  email        String?
  phone        String?
  phoneCountry String? @map("phone_country") @db.Char(2)
  website      String?

  // VAT / ЄДРПОУ / EIN — рядок як прийшов: формати і контрольні суми різні в кожній
  // країні і змінюються, валідація тут = відхилений валідний номер клієнта
  taxId String? @map("tax_id")

  // Валюта розрахунків (ISO 4217) — потрібна ДО білінгу: без неї не показати суми
  currency String @default("USD") @db.Char(3)
  // Мова листів ДО КАСТОМЕРА (аналог SPRAS у SAP KNA1), не локаль співробітника
  locale   String @default("en")

  // Відповідальний менеджер. NULL — «нічий», легальний стан.
  // FK НЕ композитний — та сама причина, що в User.avatarFile: Prisma не вміє
  // SET NULL з переліком колонок і занулила б заодно tenant_id. Захист — RLS
  ownerId String? @map("owner_id")

  // Id у системі-джерелі: ключ ідемпотентності імпорту (повторний запуск оновлює,
  // а не дублює) і зчеплення з інтеграцією
  externalId String? @map("external_id")

  tags  String[] @default([])
  notes String?

  // Адреса V1 — колонки, не окрема таблиця (docs/customers.md §4.3).
  // Коли зʼявляться документи, вони копіюють адресу В СЕБЕ на момент виставлення:
  // рахунок не має мінятися від того, що клієнт переїхав
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  region       String?
  postalCode   String? @map("postal_code")
  country      String? @db.Char(2)

  // Снапшот автора; без FK — юзера можуть видалити, запис лишається
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner          User?             @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts       CustomerContact[]
  // Зустрічі й дзвінки з цим контрагентом: блок «Upcoming» на картці + стрічка
  calendarEvents CalendarEvent[]

  @@unique([tenantId, number])
  @@unique([tenantId, externalId])
  // Опора під композитні FK майбутніх модулів (tickets/invoices → customer)
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt(sort: Desc), id])
  @@index([tenantId, ownerId])
  @@map("customers")
}

enum CustomerKind {
  ORGANIZATION
  PERSON
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Контактна особа кастомера. Вкладена сутність (не самостійний Contact, як у
// Salesforce): не існує без кастомера, і доступ до неї = доступ до нього.
model CustomerContact {
  id         String @id @default(uuid())
  tenantId   String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  customerId String @map("customer_id")

  name         String
  position     String?
  email        String?
  phone        String?
  phoneCountry String? @map("phone_country") @db.Char(2)
  // Рівно один основний на кастомера — гарантує ЧАСТКОВИЙ унікальний індекс
  // (сирим SQL у міграції: Prisma часткові індекси не вміє). Перевірка в сервісі
  // програла б гонці двох вкладок
  isPrimary    Boolean @default(false) @map("is_primary")
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитний FK: контакт не може вказати на кастомера чужого тенанта
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@map("customer_contacts")
}

// Лічильник людських номерів — СПІЛЬНИЙ на всі майбутні нумерації
// (name: 'customer', далі 'invoice', 'ticket'), не таблиця кастомерів.
//
// Чому не CREATE SEQUENCE: послідовність одна на БД (номери скачуть між тенантами,
// витікає обсяг сусіда), вона поза RLS, і головне — nextval НЕ відкочується, тобто
// дає дірки в нумерації. Тут інкремент живе в тій самій транзакції, що й сам рядок,
// тому відкат забирає і номер. Ціна — блокування рядка до коміту (створення
// серіалізується в межах тенанта); для документів, де пропуск номера — питання від
// податкової, це саме те, що потрібно.
model NumberSequence {
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  name     String
  // Бакет скидання: '' — наскрізна нумерація (майстер-дані), '2026' / '2026-09' —
  // документи з YEARLY/MONTHLY. У ключі з першого дня: додати колонку в PK згодом
  // дорожче, ніж завести її порожньою зараз
  scope    String @default("")

  lastValue Int @default(0) @map("last_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, name, scope])
  @@map("number_sequences")
}

// Конфіг нумерації тенанта. Окремо від лічильника свідомо: у них різні життєві
// цикли — конфіг редагує людина раз на рік, лічильник блокується на КОЖНІЙ
// видачі. Рядок існує тільки коли тенант змінив дефолт (NUMBER_SERIES_DEFAULTS
// у контрактах) — той самий патерн, що в notification_preferences.
model NumberSeries {
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  name     String

  prefix      String            @default("")
  padding     Int               @default(0)
  // Перший номер у КОЖНОМУ новому періоді. На вже початий лічильник не впливає —
  // для нього є окрема монотонна операція «наступний номер = N»
  startValue  Int               @default(1) @map("start_value")
  resetPeriod NumberResetPeriod @default(NONE) @map("reset_period")

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, name])
  @@map("number_series")
}

enum NumberResetPeriod {
  NONE
  YEARLY
  MONTHLY
}

// Inbox-патерн для ідемпотентності обробки job-ів (див. libs/shared JobInboxService).
// Інфра-таблиця: БЕЗ tenant_id і БЕЗ RLS — маркер ідемпотентності глобальний.
model ProcessedJob {
  id          String   @id // pg-boss job id
  jobName     String   @map("job_name")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_jobs")
}

// ============================================================================
// Календар (docs/calendar.md). Іменування з кваліфікатором: слово Event у цьому
// репозиторії зайняте messaging-повідомленнями, socket-подіями і журналом.
// ============================================================================

model CalendarEvent {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")

  title       String
  description String?
  location    String?

  kind       CalendarEventKind       @default(MEETING)
  // CANCELLED замість soft delete: учасник мусить побачити «скасовано», а не
  // «зникло». Тому скасування — окремий ендпоінт (подія), а DELETE лишається
  // виправленням щойно зробленої помилки
  status     CalendarEventStatus     @default(CONFIRMED)
  visibility CalendarEventVisibility @default(DEFAULT)
  // TRANSP із RFC 5545: чи рахувати подію зайнятістю при перевірці накладань
  busy       Boolean                 @default(true)

  // UTC-інстанти. ends_at ЕКСКЛЮЗИВНИЙ: подія — пів-інтервал [starts_at, ends_at),
  // тому перетин із вікном — starts_at < :to AND ends_at > :from (обидва строгі).
  // Одноденна all-day = [06.09 00:00, 07.09 00:00) у time_zone події
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")
  // IANA-зона, В ЯКІЙ час задали (Europe/Kyiv), а НЕ offset: offset — властивість
  // моменту, після переходу на зимовий час він інший, і «щовівторка о 10:00»
  // поїхало б на годину. Потрібна і для all-day, і для повторень (CAL-4)
  timeZone String   @map("time_zone")
  // true = час ігнорується: межі нормалізовані до опівночі в time_zone події,
  // а рендер бере ДАТУ в зоні ПОДІЇ, не глядача (docs/calendar.md §6.2)
  allDay   Boolean  @default(false) @map("all_day")

  // Організатор. NULLABLE + SetNull — як Customer.owner (рішення 2026-09-06):
  // історія команди мусить пережити звільнення людини, а Restrict перетворив би
  // офбординг на квест. Подію без організатора редагує ADMIN — ЄДИНИЙ випадок,
  // коли він має права на чужу подію
  ownerId String? @map("owner_id")

  // Контекст CRM. Конкретна колонка, а не поліморфний лінк: другого типу
  // контрагента поки немає, а рівень непрямості без споживача — борг (та сама
  // логіка, що відкинула party-модель у customers.md §2)
  customerId String? @map("customer_id")

  // Снапшот автора; без FK — юзера можуть видалити, подія лишається
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // FK НЕ композитний — та сама причина, що в Customer.owner і User.avatarFile:
  // Prisma не вміє SET NULL з переліком колонок і занулила б заодно tenant_id.
  // Крос-tenant захист — RLS на обох таблицях
  owner     User?                   @relation("CalendarEventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // FK НЕ композитний — рівно та сама грабля, що в Customer.owner: Prisma не вміє
  // SET NULL з переліком колонок і занулила б заодно tenant_id (prisma validate
  // це навіть попереджає). Крос-tenant захист — RLS на обох таблицях.
  // Саме SetNull, а не Restrict: «зустріч, яка була» не має зникати чи блокувати
  // видалення картки клієнта — журнал переживає сутність
  customer  Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  attendees CalendarEventAttendee[]
  reminders CalendarReminder[]

  // Опора під композитні FK дочірніх таблиць
  @@unique([tenantId, id])
  // Головний запит модуля — вікно
  @@index([tenantId, startsAt, endsAt])
  @@index([tenantId, ownerId, startsAt])
  @@index([tenantId, customerId, startsAt])
  @@map("calendar_events")
}

enum CalendarEventKind {
  MEETING
  CALL
  DEADLINE
  OUT_OF_OFFICE
  OTHER
}

enum CalendarEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum CalendarEventVisibility {
  DEFAULT
  PRIVATE
}

// Учасник події. У V1 — тільки юзер тенанта: зовнішній учасник вимагає листа,
// а email-канал у цьому ході свідомо не вмикаємо (CAL-3).
model CalendarEventAttendee {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  eventId  String @map("event_id")
  userId   String @map("user_id")

  role        CalendarAttendeeRole     @default(REQUIRED)
  // PARTSTAT із RFC 5545
  response    CalendarAttendeeResponse @default(NEEDS_ACTION)
  // Коли відповів — потрібне організатору («досі не відповів третій день»)
  respondedAt DateTime?                @map("responded_at")
  comment     String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Композитні FK: учасник не може вказати ні на подію, ні на юзера чужого тенанта
  event  CalendarEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Cascade)
  user   User          @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  // Двічі запросити ту саму людину неможливо
  @@unique([tenantId, eventId, userId])
  // «Мій календар» = події, де я учасник: цей індекс несе головний список
  @@index([tenantId, userId])
  @@map("calendar_event_attendees")
}

enum CalendarAttendeeRole {
  REQUIRED
  OPTIONAL
}

enum CalendarAttendeeResponse {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

// ДЕКЛАРАЦІЯ нагадування («за 30 хв»), персональна: організатор і учасник мають
// у тій самій події різні нагадування (як reminders.overrides у Google).
// Момент спрацювання тут НЕ зберігається — він рахується і матеріалізується
// в scheduled_notifications (docs/calendar.md §8.1). Пара «конфіг + розрахований
// стан» — той самий поділ, що number_series / number_sequences.
model CalendarReminder {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")
  eventId  String @map("event_id")
  userId   String @map("user_id")

  // Хвилини ДО початку, а не абсолютний момент: подію переносять, і абсолютний
  // час довелося б перераховувати на кожен зсув (а частину — забути)
  minutesBefore Int    @map("minutes_before")
  // Ключ (type, channel) закладений під email; у V1 живий рівно 'in_app'
  channel       String @default("in_app")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  CalendarEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Cascade)
  user   User          @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  // Два однакові нагадування на ту саму подію — помилка вводу, не дані
  @@unique([tenantId, eventId, userId, minutesBefore, channel])
  @@index([tenantId, eventId])
  @@map("calendar_reminders")
}

// ============================================================================
// Відкладені сповіщення — СПІЛЬНА інфраструктура (docs/notifications.md
// § «Обмеження V1 / беклог», roadmap §2.1), а не частина календаря: жодного
// calendar_ у назвах. Календар — її перший споживач.
//
// Чому не pg-boss із startAfter (docs/calendar.md §8.2): pgboss.* поза RLS —
// тенант не має права читати таблицю черги, тож ні показати «мої нагадування»,
// ні скасувати їх із доменного коду було б неможливо. Плюс ретеншн черги,
// скасування як друге джерело правди і гонки при перепрануванні.
// ============================================================================

model ScheduledNotification {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("nullif(current_setting('app.tenant_id'::text, true), ''::text)")) @map("tenant_id")

  // Коли доставити. Сканер бере рядки з fire_at <= now() атомарним claim-ом
  fireAt    DateTime @map("fire_at")
  // Ключ ідемпотентності МАТЕРІАЛІЗАЦІЇ: 'calendar_reminder:{id}:{occurrenceStart}'.
  // Повторна матеріалізація (ретрай, дві вкладки) не плодить дублів
  dedupeKey String   @map("dedupe_key")

  // Форма рядка дзеркалить notifications: сканер просто передає це в recorder
  recipientId String  @map("recipient_id")
  type        String
  payload     Json
  targetKind  String? @map("target_kind")
  targetId    String? @map("target_id")
  groupKey    String? @map("group_key")
  actorType   String  @default("system") @map("actor_type")
  actorId     String? @map("actor_id")
  actorLabel  String? @map("actor_label")

  // Захоплено сканером. Окремо від delivered_at: захоплений рядок уже в роботі,
  // і перепланування його НЕ видаляє (доставка — правда про минуле)
  claimedAt     DateTime? @map("claimed_at")
  deliveredAt   DateTime? @map("delivered_at")
  // 'stale' — дозріло більш ніж grace тому (воркер лежав). Нагадування «зустріч
  // за 30 хв», отримане через годину після початку, гірше за мовчання
  skippedReason String?   @map("skipped_reason")

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient User   @relation("ScheduledNotificationRecipient", fields: [tenantId, recipientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, recipientId, fireAt])
  // Частковий індекс сканера (WHERE ще не доставлено) — сирим SQL у міграції
  @@map("scheduled_notifications")
}
