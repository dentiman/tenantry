{
  "calendar_event": {
    "created": "<b>{{actor}}</b> scheduled <b>{{event}}</b>",
    "rescheduled": "<b>{{actor}}</b> changed the time of <b>{{event}}</b>",
    "cancelled": "<b>{{actor}}</b> cancelled <b>{{event}}</b>",
    "restored": "<b>{{actor}}</b> restored <b>{{event}}</b>",
    "deleted": "<b>{{actor}}</b> deleted <b>{{event}}</b>",
    "attendee_added": "<b>{{actor}}</b> invited <b>{{attendee}}</b> to <b>{{event}}</b>",
    "attendee_removed": "<b>{{actor}}</b> removed <b>{{attendee}}</b> from <b>{{event}}</b>",
    "rsvp_changed": "<b>{{attendee}}</b> replied {{response}} to <b>{{event}}</b>"
  }
}
