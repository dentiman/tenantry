# Плоский (hoisted) node_modules — потрібен для Docker-рантайму: NestJS-бандли
# (webpack) тримають npm-залежності external, а в runtime-образ копіюється лише
# кореневий node_modules. Без hoisting isolated-симлінки per-package губляться і
# require('argon2'/'sharp'/'pg-boss'/'prisma') падає. (той самий підхід, що в accounting)
shamefully-hoist=true
