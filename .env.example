DATABASE_URL="postgresql://saas:saas@localhost:5432/saas_skeleton"
PORT=3001

# JWT Configuration
JWT_SECRET="change-me-in-production-min-32-chars-secret-key-here"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# SMTP (apps/worker) — дефолти вже вказують на Mailpit з docker-compose, можна не задавати у dev
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM="SaaS Skeleton <noreply@saas-skeleton.local>"

# S3-сумісне файлове сховище (dev: SeaweedFS з docker-compose; прод — будь-який S3 через ці ж змінні)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=saas
S3_SECRET_KEY=saas-secret
S3_BUCKET=saas-files
S3_FORCE_PATH_STYLE=true
# Origin(и) фронта для CORS бакета (прямий PUT/GET із браузера за presigned URL)
S3_CORS_ALLOWED_ORIGINS=http://localhost:5173
