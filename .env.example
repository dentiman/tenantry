# MT-0: три ролі БД (docs/multi-tenancy-plan.md §3). Runtime ходить під saas_app
# (НЕ власник схеми, без BYPASSRLS — з MT-2 на нього діє RLS), міграції — під saas_migrator.
DATABASE_URL="postgresql://saas_app:saas_app@localhost:5432/saas_skeleton"
MIGRATE_DATABASE_URL="postgresql://saas_migrator:saas_migrator@localhost:5432/saas_skeleton"
# Control plane + системні cron-джоби (BYPASSRLS) — споживається з MT-1 (SystemPrismaService)
PLATFORM_DATABASE_URL="postgresql://saas_platform:saas_platform@localhost:5432/saas_skeleton"
# Суперюзер для `pnpm db:roles` і створення тестової БД e2e (дефолт збігається з docker-compose)
# POSTGRES_ADMIN_URL="postgresql://saas:saas@localhost:5432/postgres"
PORT=3001
# Workspace slots additionally generate API_PORT. It wins over generic PORT so tools such as
# Claude preview cannot move a non-zero slot's tenant API onto the reserved slot-0 port.
# API_PORT=3001

# JWT Configuration
# AUTH-0: ≥ 32 символи; значення нижче — плейсхолдер, API з ним НЕ стартує (скопійований
# приклад — не секрет). Згенеруй свій: openssl rand -hex 32
JWT_SECRET="change-me-in-production-min-32-chars-secret-key-here"
JWT_ACCESS_EXPIRES_IN=15m

# AUTH-1: життя сесії-ПРИСТРОЮ (замінили JWT_REFRESH_EXPIRES_DAYS).
# idle посувається кожною ротацією («сесія жива, поки нею користуються»);
# absolute рахується від логіну і НЕ посувається — це стеля життя пристрою
# AUTH_SESSION_IDLE_DAYS=7
# AUTH_SESSION_ABSOLUTE_DAYS=30
# Повторне використання ротованого токена поза 60-секундним вікном вбиває ту сесію.
# true — вбивати ВСІ сесії юзера: суворіше, але один викрадений токен тоді вибиває
# людину і з робочого ноутбука, і з телефона
# AUTH_REUSE_REVOKES_ALL_SESSIONS=false

# MT-3: control plane (apps/platform-api) — ОКРЕМИЙ секрет (security boundary між
# plane-ами: токени не крос-валідні), окремий порт
# Ті самі правила, що для JWT_SECRET (плейсхолдер відхиляється на старті)
PLATFORM_JWT_SECRET="change-me-platform-secret-min-32-chars-key-here"
PLATFORM_PORT=3002

# SMTP (apps/worker) — дефолти вже вказують на Mailpit з docker-compose, можна не задавати у dev
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM="SaaS Skeleton <noreply@saas-skeleton.local>"

# S3-сумісне файлове сховище (dev: SeaweedFS з docker-compose; прод — будь-який S3 через ці ж змінні)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=saas
S3_SECRET_KEY=saas-secret
S3_BUCKET=saas-files
S3_FORCE_PATH_STYLE=true
# Origin(и) фронта для CORS бакета (прямий PUT/GET із браузера за presigned URL)
S3_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Realtime (RT-0…RT-2): Valkey — брокер Socket.IO (Redis Streams adapter) і сховище
# presence-leases. Дефолти збігаються з docker-compose, тому в dev можна не задавати.
REDIS_URL=redis://:saas-realtime@localhost:6379
# Префікс усіх realtime-ключів — щоб presence не змішувалась із чужими даними в спільному Valkey
REALTIME_KEY_PREFIX=saas:rt
# Allowlist origin-ів гейтвею. Перевіряється через Socket.IO allowRequest:
# browser CORS захищає HTTP, але НЕ WebSocket-транспорт
REALTIME_ALLOWED_ORIGINS=http://localhost:5173
# Скільки живе lease пари (user, apiNode) без продовження → бюджет offline-детекції
REALTIME_LEASE_TTL_MS=60000
# Як часто нода batch-ом продовжує leases своїх локальних юзерів
REALTIME_HEARTBEAT_MS=20000
# Вікно Socket.IO connection state recovery (пропущені пакети після короткого розриву)
REALTIME_RECOVERY_MS=120000
# RT-3: як часто ЖИВА сесія оновлює довговічний users.last_seen_at (не залежить від брокера)
REALTIME_LAST_SEEN_MARK_MS=300000
# Період зливу буфера позначок last-seen у БД; мусить бути ≤ REALTIME_LAST_SEEN_MARK_MS
REALTIME_LAST_SEEN_FLUSH_MS=15000

# AUTH-0: мережевий периметр і обмеження частоти (дефолти — у коді, можна не задавати)
# Allowlist веб-походжень tenant-api — ОДИН список на HTTP-CORS і Socket.IO.
# Не задано → REALTIME_ALLOWED_ORIGINS → http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# Control plane — окреме ім'я: обидва API читають цей самий .env (дефолт http://localhost:5174)
# PLATFORM_CORS_ALLOWED_ORIGINS=http://localhost:5174
# Скільки проксі перед API довіряти X-Forwarded-For (1 = nginx у контейнері web). НЕ `true`:
# тоді клієнт підставляє свій IP сам і обходить ліміти
# TRUST_PROXY_HOPS=1
# Пороги (бойові значення зі spec). Лічильники — у Valkey, спільні для реплік;
# недоступний Valkey → ліміт не діє (fail-open) з warn-логом `throttler_storage_unavailable`
# THROTTLE_DEFAULT_LIMIT_PER_MINUTE=120  # на користувача; анонімні запити — на ip
# AUTH_LOGIN_LIMIT_PER_MINUTE=5          # на пару (email, ip)
# AUTH_LOGIN_IP_LIMIT_PER_MINUTE=20      # на ip
# AUTH_REFRESH_LIMIT_PER_MINUTE=30       # на ip
# ACCOUNT_SENSITIVE_LIMIT_PER_HOUR=10    # зміна пароля, «вийти звідусіль» — на користувача
# Стеля очікування Valkey перед fail-open — константа 200 мс у throttle.config.ts, не env

# AUTH-2: refresh у httpOnly cookie (saas_refresh / saas_platform_refresh, Path=/api/auth).
# Дефолт true (прод/тестовий https); локалка й тестовий прод по http — false
COOKIE_SECURE=false
# Control plane (AUTH-2): access 15m, refresh-cookie — той самий каркас, що tenant-api.
# PLATFORM_JWT_ACCESS_EXPIRES_IN=15m
# platform-api читає ті самі REDIS_URL/REALTIME_KEY_PREFIX і пороги THROTTLE_*/AUTH_LOGIN_*/
# AUTH_REFRESH_LIMIT_PER_MINUTE, що вище (другий споживач throttler-а, R-15) — окремих
# змінних не заводимо

# AUTH-3: відновлення доступу — одноразові посилання (auth/password-reset, account/email-change)
# Базовий URL tenant-web для лінків у листах (без хвостового /); не задано → http://localhost:5173
# APP_PUBLIC_URL=http://localhost:5173
# AES-256-GCM ключ для CryptoService (api + worker, ОБОВ'ЯЗКОВИЙ, процес не стартує без нього):
# токен одноразового посилання шифрується перед публікацією (pgboss.job поза RLS, план D-11).
# Значення нижче — робочий приклад (32 байти, валідний base64), НЕ секрет реального середовища.
# Згенеруй свій: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="SsjVoRkl29TwYnoLd9opr2TfJ4aNMeC7bax8ZBkFg80="
# Пороги скидання пароля/зміни email — КОНСТАНТИ в коді (3/год, 20/год, 5/год, 10/хв),
# не env (events-and-config.md §5, plan D-15)

# Workspace slots (docs/workspace-slots.md): ізольований dev-стек на паралельний
# git worktree/agent workspace. Нічого з цього блоку заповнювати руками не треба —
# `pnpm ws:init [N]` сам генерує .env.local із зсувом портів +100·N і власними секретами
# (WORKSPACE_SLOT, COMPOSE_PROJECT_NAME, POSTGRES_PORT, S3_PORT, MAILPIT_SMTP_PORT, API_PORT,
# MAILPIT_UI_PORT, WEB_PORT, PLATFORM_WEB_PORT — REDIS_PORT вже вище). `pnpm ws:down`
# гасить контейнери й volume-и слота.

# ── AI-асистент (AI-0, docs/ai-assistant.md) ────────────────────────────────────
# Дефолт ВИМКНЕНО: скелетон без провайдера не має показувати напівробочого
# асистента. Увімкнене значення відкриває панель у tenant-порталі і роути /api/ai/*
AI_ENABLED=false
# Провайдер генерації. У AI-0 легальне значення ОДНЕ — `fake`: канований стрім без
# ключа, без мережі й без витрат. Невідоме значення валить старт процесу, а не
# відкочується тихо на фейк. Реальний OpenAI-сумісний провайдер приходить в AI-1
AI_PROVIDER=fake
# Модель. У AI-0 їде лише в лог і в колонку ai_messages.model
# AI_MODEL=fake-1
# Стеля вартості ОДНОГО ходу
# AI_MAX_OUTPUT_TOKENS=1024
# Скільки минулих ходів їде в промпт (решта лишається в БД, але не в контексті)
# AI_HISTORY_TURNS=10
# Стеля часу на генерацію; після неї відповідь позначається FAILED/TIMEOUT
# AI_REQUEST_TIMEOUT_MS=60000
# Коалесування дельт у сокет. НЕ токен-за-токеном: 500 кадрів на відповідь винесли б
# maxLen стріму Valkey разом із presence і сповіщеннями (docs/ai-assistant.md)
# AI_STREAM_FLUSH_MS=120
# Як часто скидати накопичений текст у БД: саме це робить правдивим «частковий вивід
# переживає обрив» і reconnect посеред генерації
# AI_PARTIAL_PERSIST_MS=2000
# Частота питань на КОРИСТУВАЧА. Поки квот токенів немає (AI-1), це єдиний рубіж
# проти циклу, який набиває чергу
# AI_ASK_LIMIT_PER_MINUTE=10
#
# УВАГА для AI-1 і далі, коли зʼявиться справжній провайдер:
#  - на ключі провайдера МАЄ бути виставлена жорстка місячна стеля витрат. Жоден код
#    у застосунку не захистить від рахунку, якщо в ньому буде баг; стеля в кабінеті
#    провайдера коштує нуль і ставиться за хвилину;
#  - провайдер стає СУБПРОЦЕСОРОМ обробки даних: внеси його у свій перелік
#    субпроцесорів і DPA, а для ЄС увімкни маршрутизацію без логування.
