# MT-0: три ролі БД (docs/multi-tenancy-plan.md §3). Runtime ходить під saas_app
# (НЕ власник схеми, без BYPASSRLS — з MT-2 на нього діє RLS), міграції — під saas_migrator.
DATABASE_URL="postgresql://saas_app:saas_app@localhost:5432/saas_skeleton"
MIGRATE_DATABASE_URL="postgresql://saas_migrator:saas_migrator@localhost:5432/saas_skeleton"
# Control plane + системні cron-джоби (BYPASSRLS) — споживається з MT-1 (SystemPrismaService)
PLATFORM_DATABASE_URL="postgresql://saas_platform:saas_platform@localhost:5432/saas_skeleton"
# Суперюзер для `pnpm db:roles` і створення тестової БД e2e (дефолт збігається з docker-compose)
# POSTGRES_ADMIN_URL="postgresql://saas:saas@localhost:5432/postgres"
PORT=3001

# JWT Configuration
JWT_SECRET="change-me-in-production-min-32-chars-secret-key-here"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# MT-3: control plane (apps/platform-api) — ОКРЕМИЙ секрет (security boundary між
# plane-ами: токени не крос-валідні), окремий порт
PLATFORM_JWT_SECRET="change-me-platform-secret-min-32-chars-key-here"
PLATFORM_PORT=3002

# SMTP (apps/worker) — дефолти вже вказують на Mailpit з docker-compose, можна не задавати у dev
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM="SaaS Skeleton <noreply@saas-skeleton.local>"

# S3-сумісне файлове сховище (dev: SeaweedFS з docker-compose; прод — будь-який S3 через ці ж змінні)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=saas
S3_SECRET_KEY=saas-secret
S3_BUCKET=saas-files
S3_FORCE_PATH_STYLE=true
# Origin(и) фронта для CORS бакета (прямий PUT/GET із браузера за presigned URL)
S3_CORS_ALLOWED_ORIGINS=http://localhost:5173
