{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": "../../",
    "target": "ES2023",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@saas-skeleton/database": ["../../libs/database/src/index.ts"],
      "@saas-skeleton/database/*": ["../../libs/database/src/*"],
      "@saas-skeleton/contracts": ["../../libs/contracts/src/index.ts"],
      "@saas-skeleton/contracts/*": ["../../libs/contracts/src/*"],
      "@saas-skeleton/shared": ["../../libs/shared/src/index.ts"],
      "@saas-skeleton/shared/*": ["../../libs/shared/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "../../libs/*/src/**/*"],
  "exclude": ["node_modules", "dist"],
  // files:true — щоб ts-node (openapi:generate) бачив ambient-декларації з src/types
  "ts-node": { "files": true }
}
