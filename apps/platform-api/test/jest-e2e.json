{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "globalSetup": "<rootDir>/../api/test/global-setup.ts",
  "setupFiles": [
    "<rootDir>/../api/test/setup-env.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.spec.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@saas-skeleton/contracts/platform$": "<rootDir>/../../libs/contracts/src/platform/index.ts",
    "^@saas-skeleton/shared/errors$": "<rootDir>/../../libs/shared/src/errors/index.ts",
    "^@saas-skeleton/shared/auth/throttler$": "<rootDir>/../../libs/shared/src/auth/throttler/index.ts",
    "^@saas-skeleton/shared/(.*)$": "<rootDir>/../../libs/shared/src/$1"
  }
}
