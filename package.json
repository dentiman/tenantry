{
  "name": "saas-skeleton",
  "version": "0.0.1",
  "private": true,
  "description": "SaaS Skeleton — multitenant CRM/ERP foundation (NestJS + React)",
  "scripts": {
    "docker:up": "sh -c 'if [ -f .env.local ]; then docker compose --env-file .env.local -f docker/docker-compose.yml up -d; elif [ -f .env ]; then docker compose --env-file .env -f docker/docker-compose.yml up -d; else docker compose -f docker/docker-compose.yml up -d; fi'",
    "docker:down": "sh -c 'if [ -f .env.local ]; then docker compose --env-file .env.local -f docker/docker-compose.yml down; elif [ -f .env ]; then docker compose --env-file .env -f docker/docker-compose.yml down; else docker compose -f docker/docker-compose.yml down; fi'",
    "docker:prod:up": "docker compose -f docker/docker-compose.prod.yml --env-file .env.production up -d",
    "docker:prod:down": "docker compose -f docker/docker-compose.prod.yml --env-file .env.production down",
    "db:generate": "pnpm --filter @saas-skeleton/database db:generate",
    "db:roles": "pnpm --filter @saas-skeleton/database db:roles",
    "db:migrate:dev": "pnpm --filter @saas-skeleton/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @saas-skeleton/database db:migrate:deploy",
    "db:seed": "pnpm --filter @saas-skeleton/database db:seed",
    "db:studio": "pnpm --filter @saas-skeleton/database db:studio",
    "db:reset": "pnpm --filter @saas-skeleton/database db:reset",
    "ws:init": "tsx scripts/workspace-init.ts",
    "ws:down": "sh -c '[ -f .env.local ] && docker compose --env-file .env.local -f docker/docker-compose.yml down -v || echo \"Немає .env.local — слот не ініціалізовано.\"'",
    "api:dev": "pnpm --filter @saas-skeleton/api dev",
    "api:build": "pnpm --filter @saas-skeleton/api build",
    "api:start": "pnpm --filter @saas-skeleton/api start",
    "api:test:e2e": "pnpm --filter @saas-skeleton/api test:e2e",
    "platform:dev": "pnpm --filter @saas-skeleton/platform-api dev",
    "platform:build": "pnpm --filter @saas-skeleton/platform-api build",
    "platform:start": "pnpm --filter @saas-skeleton/platform-api start",
    "platform:test:e2e": "pnpm --filter @saas-skeleton/platform-api test:e2e",
    "platform:openapi:generate": "pnpm --filter @saas-skeleton/platform-api openapi:generate",
    "worker:dev": "pnpm --filter @saas-skeleton/worker dev",
    "worker:build": "pnpm --filter @saas-skeleton/worker build",
    "worker:start": "pnpm --filter @saas-skeleton/worker start",
    "web:dev": "pnpm --filter @saas-skeleton/web dev",
    "web:build": "pnpm --filter @saas-skeleton/web build",
    "web:codegen": "pnpm --filter @saas-skeleton/web codegen",
    "web:test": "pnpm --filter @saas-skeleton/web test",
    "platform:web:dev": "pnpm --filter @saas-skeleton/platform-web dev",
    "platform:web:build": "pnpm --filter @saas-skeleton/platform-web build",
    "platform:web:codegen": "pnpm --filter @saas-skeleton/platform-web codegen",
    "openapi:generate": "pnpm --filter @saas-skeleton/api openapi:generate",
    "ai:knowledge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-knowledge.ts",
    "ai:knowledge:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-knowledge.ts --check",
    "lint": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-knowledge.ts --check && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "logs:tail": "tail -f apps/api/logs/api-pretty.log",
    "logs:clean": "rm -rf apps/api/logs/*.log*",
    "prepare": "husky",
    "ai:docs:preview": "tsx scripts/ai-docs-preview.ts",
    "ai:docs:ingest": "tsx --tsconfig libs/shared/tsconfig.json scripts/ai-docs-ingest.ts",
    "ai:docs:search": "tsx --tsconfig libs/shared/tsconfig.json scripts/ai-docs-search.ts",
    "ai:docs:eval": "tsx --tsconfig libs/shared/tsconfig.json scripts/ai-docs-eval.ts"
  },
  "keywords": [
    "saas",
    "crm",
    "erp",
    "skeleton",
    "nestjs",
    "react",
    "template"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "@tailwindcss/oxide",
      "unrs-resolver",
      "sharp"
    ],
    "overrides": {
      "zod": "^4.4.3"
    }
  }
}
