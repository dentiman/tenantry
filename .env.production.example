# Продакшн-env: скопіювати у .env.production (gitignored) і заповнити.
# Читається двічі: docker compose (docker:prod:up — змінні SAAS_*/POSTGRES_*)
# і апками на хості (api/worker підхоплюють .env.production через симлінк/копію в .env).

# --- інфраструктура (docker-compose.prod.yml) ---
# Абсолютний шлях до даних на хості; бекапити postgres/ і seaweedfs/ узгоджено
SAAS_DATA_DIR=/srv/saas-skeleton/data
POSTGRES_USER=saas
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=saas_skeleton
# POSTGRES_PORT=5432
# S3_PORT=8333
# SAAS_S3_CONFIG=./seaweedfs/s3.prod.json

# --- застосунок (apps/api, apps/worker на хості) ---
# MT-0: ролі створює оператор разово (`pnpm db:roles` з POSTGRES_ADMIN_URL суперюзера,
# або SQL з docker/postgres/init/01-roles.sql із власними паролями). Runtime — saas_app
# (без BYPASSRLS), міграції — saas_migrator, control plane — saas_platform.
DATABASE_URL="postgresql://saas_app:CHANGE_ME_openssl_rand_hex_24@localhost:5432/saas_skeleton"
MIGRATE_DATABASE_URL="postgresql://saas_migrator:CHANGE_ME_openssl_rand_hex_24@localhost:5432/saas_skeleton"
PLATFORM_DATABASE_URL="postgresql://saas_platform:CHANGE_ME_openssl_rand_hex_24@localhost:5432/saas_skeleton"
PORT=3001
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
# MT-3: control plane — окремий секрет і порт; PLATFORM_DATABASE_URL — вище
PLATFORM_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
PLATFORM_PORT=3002

# Реальний SMTP (Mailpit у проді немає)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM="SaaS Skeleton <noreply@example.com>"

# S3: публічний HTTPS-домен сховища (reverse proxy → 127.0.0.1:8333, Host зберігати!)
# Браузер ходить на нього напряму за presigned URL — localhost тут працювати НЕ буде
S3_ENDPOINT=https://files.example.com
S3_REGION=us-east-1
# Ті самі значення, що в docker/seaweedfs/s3.prod.json
S3_ACCESS_KEY=CHANGE_ME_same_as_s3_prod_json
S3_SECRET_KEY=CHANGE_ME_same_as_s3_prod_json
S3_BUCKET=saas-files
S3_FORCE_PATH_STYLE=true
# Origin фронта (звідки браузер робить PUT/GET до сховища)
S3_CORS_ALLOWED_ORIGINS=https://app.example.com
