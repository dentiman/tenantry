# Несекретний конфіг Swarm-стеку, спільний для обох стендів (GitLab → saas-dev, GitHub → Hetzner).
# Репозиторій публічний: СЕКРЕТІВ ТУТ НЕ БУВАЄ. Секрети й адреси конкретного стенда — в окремому
# env-файлі, який підвантажується ПІСЛЯ цього і перекриває його (шаблон — docker/deploy.env.example):
#   • Hetzner  — /etc/saas/deploy.env на сервері (scripts/hetzner/common.sh);
#   • saas-dev — GitLab CI/CD Variable `DEPLOY_ENV` типу File (.gitlab-ci.yml).
# Решта змінних має дефолти в docker/docker-compose.stack.yml.

# --- SMTP (воркер) ---
SMTP_HOST="smtp.example.com"
SMTP_FROM="Tenantry <noreply@example.com>"

# ── AI-асистент ─────────────────────────────────────────────────────────────────────
# Ключ провайдера (AI_API_KEY) — лише в секретному файлі стенда або в налаштуваннях control plane
# (зашифровано AI_SECRETS_KEY), ніколи тут. На ключі — жорстка місячна стеля витрат у провайдера.
AI_ENABLED=true
AI_PROVIDER=openai-compat
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="openai/gpt-5.6-luna"
# Демо-стенд: кожен юзер може поставити асистенту 3 питання за добу (UTC). Для прод-інсталяції —
# прибрати: лишаться токенні квоти
AI_QUOTA_USER_DAILY_MESSAGES=3
# Знання асистента — з pgvector-індексу власної документації (docs/ai-knowledge), а не з вбудованого
# корпусу; індекс по кожному тенанту будує `ai_index_dev` / Ops → ai index (docs/demo.md §7). Без
# індексу тенант відповідає «не знаю», тихого відкату на статичний корпус немає
AI_KNOWLEDGE_BACKEND=postgres
AI_KNOWLEDGE_PRODUCT=saas
