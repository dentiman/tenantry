# Шаблон СЕКРЕТНОГО env-файлу стенда. Сам файл у git не потрапляє ніколи (репозиторій публічний).
# Де живе справжній:
#   • Hetzner  — /etc/saas/deploy.env на сервері (root:github-runner, 0640); docs/deploy-hetzner.md
#   • saas-dev — GitLab → Settings → CI/CD → Variables → `DEPLOY_ENV`, тип File, Protected;
#                docs/deploy-swarm.md
# Копія кожного файлу — у менеджері паролів власника: втрата = неможливість розшифрувати
# збережені AI-ключі (AI_SECRETS_KEY) і токени в черзі (ENCRYPTION_KEY).
#
# Підвантажується ПІСЛЯ docker/stack.env і перекриває його. Порожнє обовʼязкове значення валить
# розкат до того, як стек чіпали (scripts/deploy/require-env.sh).
#
# Генерація: openssl rand -hex 32  (hex)  ·  openssl rand -base64 32  (base64)
# Паролі, що потрапляють в URL (DB_*, POSTGRES_PASSWORD): лише [A-Za-z0-9_-].
# Після першого розкату НЕ міняти без процедури: POSTGRES_PASSWORD/S3_* вшиті в томи й swarm-config,
# DB_*_PASSWORD — застосувати `db:roles` (Ops → db_roles), ENCRYPTION_KEY/AI_SECRETS_KEY — перешифрувати.

# --- обовʼязкові ---
POSTGRES_PASSWORD=
DB_APP_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_PLATFORM_PASSWORD=
JWT_SECRET=
PLATFORM_JWT_SECRET=
ENCRYPTION_KEY=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Публічні адреси стенда (origin, з якого браузер відкриває web / platform-web / S3)
APP_PUBLIC_URL=
REALTIME_ALLOWED_ORIGINS=
PLATFORM_CORS_ALLOWED_ORIGINS=
S3_ENDPOINT=
S3_CORS_ALLOWED_ORIGINS=

# --- за потреби ---
# AI_SECRETS_KEY=              # шифрує AI-ключ, збережений через control plane (AI-5)
# AI_API_KEY=                  # ключ провайдера напряму (альтернатива control plane)
# SEED_ADMIN_PASSWORD=         # пароль admin@example.com для `db:seed`
# SEED_PLATFORM_PASSWORD=      # пароль platform@example.com для `db:seed`
# SAAS_DATA_DIR=/srv/saas-prod/data
# COOKIE_SECURE=true           # false лише для стенда на голому http (saas-dev)
# TRUST_PROXY_HOPS=1           # скільки проксі перед api (Caddy → nginx web)
# SMTP_HOST= / SMTP_PORT= / SMTP_FROM=   # перекривають заглушки з docker/stack.env
